---
import MainLayout from "../../layouts/MainLayout.astro";

const posts = [
  {
    title: "The case for a bug bounty in ML",
    href: "/blog/the-case-for-a-bug-bounty-in-ml/",
    date: "Essay",
    description: "A proposal for paying careful, adversarial checks of machine learning papers."
  }
];
---

<MainLayout title="Blog | Amit Kiran Rege" description="Technical notes, paper deep-dives, and experiments." pageClass="blog-page">
  <section class="section shell reveal">
    <div class="section-head">
      <h1>Blog</h1>
      <p>Technical notes, paper deep-dives, and experiments.</p>
    </div>

    <div class="stack">
      {
        posts.map((post) => (
          <article class="card glass">
            <p class="meta">{post.date}</p>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <a class="text-link" href={post.href}>Read post</a>
          </article>
        ))
      }
    </div>
  </section>
</MainLayout>
