---
import MainLayout from "../../layouts/MainLayout.astro";

interface Post {
  title: string;
  href: string;
  date: string;
  description: string;
}

// Hidden for now. To publish a post, add it here and remove the leading
// underscore from its Markdown file in src/pages/blog/.
const posts: Post[] = [];
---

<MainLayout title="Blog | Amit Kiran Rege" description="Technical notes, paper deep-dives, and experiments." pageClass="blog-page">
  <section class="section shell reveal">
    <div class="section-head">
      <h1>Blog</h1>
      <p>Technical notes, paper deep-dives, and experiments.</p>
    </div>

    <div class="stack">
      {posts.length === 0 ? (
        <article class="card glass construction-card">
          <p class="construction-tag">Under Construction</p>
          <h2>New writing is in progress</h2>
          <p>Coming soon!</p>
        </article>
      ) : (
        posts.map((post) => (
          <article class="card glass">
            <p class="meta">{post.date}</p>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <a class="text-link" href={post.href}>Read post</a>
          </article>
        ))
      )}
    </div>
  </section>
</MainLayout>
