---
import MainLayout from "../../layouts/MainLayout.astro";

const posts = [
  {
    title: "Dummy Blog Post",
    href: "/blog/dummy-post/",
    date: "Draft placeholder",
    description: "A temporary placeholder article that can be replaced with the final title and post content."
  }
];
---

<MainLayout title="Blog | Amit Kiran Rege" description="Technical notes, paper deep-dives, and experiments." pageClass="blog-page">
  <section class="section shell reveal">
    <div class="section-head">
      <h1>Blog</h1>
      <p>Technical notes, paper deep-dives, and experiments.</p>
    </div>

    <div class="stack">
      {
        posts.map((post) => (
          <article class="card glass">
            <p class="meta">{post.date}</p>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
            <a class="text-link" href={post.href}>Read post</a>
          </article>
        ))
      }
    </div>
  </section>
</MainLayout>
