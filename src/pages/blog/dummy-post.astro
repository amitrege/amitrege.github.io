---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Dummy Blog Post | Amit Kiran Rege" description="Temporary placeholder blog post." pageClass="blog-page">
  <article class="section shell reveal">
    <div class="section-head">
      <p class="meta">Draft placeholder</p>
      <h1>Dummy Blog Post</h1>
      <p>A temporary article page for checking the blog publishing path.</p>
    </div>

    <div class="card glass article-body">
      <p>
        This is a dummy blog post. It exists so the blog index, article route, build, deploy,
        and live-site verification can be checked before the final title and content are added.
      </p>
      <p>
        Replace this page with the final post file when it is ready.
      </p>
    </div>
  </article>
</MainLayout>
