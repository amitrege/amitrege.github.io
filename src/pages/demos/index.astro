---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import projects from "../../data/projects.json";
---

<MainLayout title="Demos | Amit Kiran Rege" description="Interactive demos and research engineering experiments." pageClass="blog-page">
  <section class="section shell reveal">
    <div class="section-head">
      <h1>All Demos and Side Projects</h1>
      <p>Complete list of prototypes, tools, and research engineering experiments.</p>
    </div>

    <div class="stack">
      {
        projects.map((project) => (
          <ProjectCard project={project} headingTag="h2" />
        ))
      }
    </div>
  </section>
</MainLayout>
